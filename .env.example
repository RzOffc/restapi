# Salin jadi .env.local untuk lokal. Isi juga semuanya di Vercel (Settings > Environment Variables).

# Neon Postgres (connection string dari dashboard Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js (buat dengan: openssl rand -base64 32)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL publik website (dipakai untuk callback pembayaran). Tanpa garis miring di akhir.
SITE_URL=http://localhost:3000

# Duitku (sandbox dulu untuk uji coba, ganti ke production saat live)
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox
